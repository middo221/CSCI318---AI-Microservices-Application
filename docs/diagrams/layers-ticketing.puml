@startuml layers-ticketing
' Report §3.2 — ticketing-service layers, from the classes on main.
' Second pass (FR-11): add the refund-issued / event-cancelled consumers that call voidTicketsFor.
!pragma layout smetana
!include include/style.iuml
set separator ::
hide empty members
skinparam linetype polyline

title ticketing-service — layered architecture (au.edu.uow.csci318.conference.ticketing)

package "api  (presentation layer)" as api <<api>> {
  class TicketController <<@RestController>>
  class GateController <<@RestController>>
  class GlobalExceptionHandler <<@RestControllerAdvice>>
  package "api.dto" as api_dto {
    class "TransferTicketRequest\nCheckInRequest" as reqs <<record>>
    class "TicketResponse\nCheckInResponse" as resps <<record>>
  }
}

package "application  (service layer)" as application <<application>> {
  class TicketApplicationService <<@Service>>
  package "application.command" as app_cmd {
    class "IssueTicketsCommand\nTransferTicketCommand\nCheckInCommand" as cmds <<record>>
  }
}

package "domain  (domain layer)" as domain <<domain>> {
  package "domain.model" as dom_model {
    class Ticket <<AggregateRoot>>
    class CheckIn <<Entity>>
    class TransferRecord <<Entity>>
    class "TicketCode · Holder · Gate" as vos <<ValueObject>>
  }
  package "domain.service" as dom_service {
    class CheckInPolicy <<DomainService>>
  }
  package "domain.repository" as dom_repo {
    interface TicketRepository <<Port>>
  }
  package "domain.event" as dom_event {
    interface DomainEventPublisher <<Port>>
  }
}

package "infrastructure  (infrastructure layer)" as infrastructure <<infrastructure>> {
  package "infrastructure.messaging" as inf_msg {
    class RegistrationEventConsumers <<@Configuration>>
    class ProcessedEventStore <<@Component>>
    class ProcessedEvent <<@Entity>>
    interface ProcessedEventJpaRepository <<Spring Data>>
    class StreamBridgeDomainEventPublisher <<@Component>>
  }
  package "infrastructure.persistence" as inf_persist {
    class JpaTicketRepository <<@Repository>>
    interface TicketJpaRepository <<Spring Data>>
  }
}

' api -> application
TicketController ..> TicketApplicationService
GateController ..> TicketApplicationService
reqs ..> cmds : toCommand(...)
resps ..> Ticket : from(...)

' application -> domain
TicketApplicationService ..> Ticket
TicketApplicationService ..> CheckInPolicy
TicketApplicationService ..> TicketRepository
TicketApplicationService ..> DomainEventPublisher

' domain internals
Ticket *-- CheckIn
Ticket *-- TransferRecord
Ticket *-- vos
CheckInPolicy ..> Ticket : admit(ticket)

' infrastructure implements the domain's ports
TicketRepository <|.. JpaTicketRepository
DomainEventPublisher <|.. StreamBridgeDomainEventPublisher
JpaTicketRepository --> TicketJpaRepository : delegates
ProcessedEventStore --> ProcessedEventJpaRepository
ProcessedEventJpaRepository ..> ProcessedEvent

' inbound adapter calls the application layer
TicketApplicationService <.. RegistrationEventConsumers : registration-confirmed →\nissue(IssueTicketsCommand)
RegistrationEventConsumers --> ProcessedEventStore : markProcessed(eventId)

note bottom of StreamBridgeDomainEventPublisher
  AFTER_COMMIT send.
  Topics: ticket-issued, ticket-transferred,
  ticket-voided (key ticketCode);
  attendee-checked-in (key sessionId).
end note

note bottom of dom_model
  Domain exceptions: TicketNotFoundException (404),
  TicketVoidException (409 TICKET_VOID),
  AlreadyCheckedInException (409 ALREADY_CHECKED_IN).
  TicketApplicationService.voidTicketsFor(...) exists
  but nothing on main calls it yet.
end note

legend right
  <b>Dependency rule</b>
  api ──> application ──> domain <── infrastructure
  The Kafka consumer is an <i>inbound</i> adapter:
  like a controller, it calls the application layer.
  hollow triangle = implements a domain port
endlegend
@enduml
