' Shared look for every Converge diagram. Included, never rendered on its own.
' Colours are print-safe pastels so the diagrams survive a greyscale report.

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam backgroundColor white
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam ArrowColor #3B3B3B
skinparam ArrowFontSize 10
skinparam ArrowFontColor #3B3B3B
skinparam packageStyle rectangle
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #B8A04A
skinparam NoteFontSize 10
skinparam LegendBackgroundColor #FAFAFA
skinparam LegendBorderColor #9E9E9E
skinparam LegendFontSize 10
skinparam footerFontSize 9
skinparam footerFontColor #707070

' DDD stereotypes used by the domain model
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #555555
  BackgroundColor<<AggregateRoot>> #FFD8A8
  BackgroundColor<<Entity>> #FFF0DC
  BackgroundColor<<ValueObject>> #DCEBFF
  BackgroundColor<<DomainService>> #D8F0D8
  BackgroundColor<<DomainEvent>> #EADCF5
  BackgroundColor<<ReadModel>> #D4F1F4
  BackgroundColor<<Port>> #F0F0F0
  BackgroundColor<<Agent>> #FCE4EC
}

' Layer colours used by the layered-architecture diagrams
skinparam package {
  BorderColor #6B6B6B
  BackgroundColor<<api>> #EAF2FB
  BackgroundColor<<application>> #EDF7ED
  BackgroundColor<<domain>> #FFF4E0
  BackgroundColor<<infrastructure>> #F3ECF8
}

